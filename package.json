{
  "name": "jev-inbox",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Chrome extension that puts unread Gmail first, critical on top, labeled by TypeSafe Jev.",
  "repository": "github:fabolivark/jev-ginbox",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "icons": "node scripts/icons.mjs",
    "store-images": "npm run build && node scripts/store-images.mjs",
    "test": "node scripts/test.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "^3.0.4",
    "@types/chrome": "^0.3.0",
    "ai": "^7.0.111",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright": "^1.57.0"
  }
}
